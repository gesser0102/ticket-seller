# Postgres (usado pelo docker-compose e pela API)
POSTGRES_USER=ticket_seller
POSTGRES_PASSWORD=ticket_seller
POSTGRES_DB=ticket_seller
DATABASE_URL=postgresql://ticket_seller:ticket_seller@localhost:5433/ticket_seller?schema=public

# Postgres de teste (serviço "postgres_test" do docker-compose, isolado do banco de dev)
DATABASE_URL_TEST=postgresql://ticket_seller_test:ticket_seller_test@localhost:5434/ticket_seller_test?schema=public

# API
PORT=3000
SESSION_SECRET=troque-este-valor-em-producao
COOKIE_SECURE=false

# TMDb (https://developer.themoviedb.org/docs)
TMDB_API_KEY=

# Sentry (opcional — sem DSN configurado, o SDK não envia nada)
SENTRY_DSN=

# Frontend (Vite, dev only — em produção é same-origin)
VITE_API_BASE_URL=/api
